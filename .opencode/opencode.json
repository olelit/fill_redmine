{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "work-assistant": {
        "type": "local",
        "command": [".venv/bin/python", "-m", "mcp_server"],
        "cwd": ".",
        "codemode": false,
        "protocol": "legacy",
        "environment": {
          "YOUTRACK_BASE_URL": "https://driv.youtrack.cloud"
        },
        "timeout": {
          "startup": 30000
        }
      }
    }
  }
}
